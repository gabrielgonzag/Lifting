# Copy this file to .env and replace the values from your Supabase project.
# These VITE_ values are exposed to the frontend, so use only the public key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Do not put SUPABASE_SERVICE_ROLE_KEY, database passwords or access tokens here.
